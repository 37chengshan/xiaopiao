<?xml version="1.0" encoding="utf-8"?>
<!-- Splash logo: a mini thermal printer with the day's receipt coming out of the slit.
     Sizes are in a 108x108 viewport; the platform scales it inside the 192dp icon window. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- printer body -->
    <group android:name="printer">
        <path
            android:fillColor="#1D1D1F"
            android:pathData="M34,22 L74,22 L78,26 L78,40 L74,44 L34,44 L30,40 L30,26 Z" />
        <!-- paper slit -->
        <path
            android:fillColor="#F5F3EE"
            android:pathData="M38,38 L70,38 L70,41 L38,41 Z" />
        <!-- indicator light -->
        <path
            android:fillColor="#B25000"
            android:pathData="M36.2,30.4 m-1.6,0 a1.6,1.6 0 1,0 3.2,0 a1.6,1.6 0 1,0 -3.2,0" />
    </group>

    <!-- the paper: a strip with a torn (zig-zag) bottom edge -->
    <group android:name="paper">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M38,40 L70,40 L70,74 L66,78 L62,74 L58,78 L54,74 L50,78 L46,74 L42,78 L38,74 Z" />
        <!-- printed content, revealed after the strip has rolled out -->
        <group android:name="paperInk" android:alpha="0">
            <path
                android:strokeColor="#1D1D1F"
                android:strokeAlpha="0.22"
                android:strokeWidth="2"
                android:strokeLineCap="round"
                android:pathData="M44,48 L64,48 M44,55 L64,55 M44,62 L58,62" />
            <!-- the total: one bolder rule, so the strip reads as a receipt and not a card -->
            <path
                android:strokeColor="#1D1D1F"
                android:strokeAlpha="0.55"
                android:strokeWidth="3"
                android:strokeLineCap="round"
                android:pathData="M44,69 L60,69" />
        </group>
    </group>
</vector>
