[Unit]
Description=Today Receipt SQLite online backup
After=xiaopiao-api.service

[Service]
Type=oneshot
User=xiaopiao
Group=xiaopiao
ExecStart=/opt/xiaopiao/current/deploy/backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/xiaopiao
UMask=0077
